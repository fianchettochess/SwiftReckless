# Swift / SPM
.build/
Package.resolved
*.o
*.d
DerivedData/

# Xcode
*.xcodeproj/
xcuserdata/

# Rust
rust/target/
# `rust/Cargo.lock` is committed because this repository builds and ships
# native binary artifacts from the Rust crate.

# Python bytecode from .github/scripts helpers — never commit build artifacts.
__pycache__/
*.pyc

# NEVER COMMIT ENGINE WEIGHTS / NNUE NETS
# (same policy as Fianchetto / SwiftStockfish)
*.nnue
*.onnx
*.bin
networks/

# macOS
.DS_Store

# Temporary download parts
*.part

# The RecklessFFI.xcframework IS committed (like SwiftStockfish's), so a fresh
# clone / CI resolves the binaryTarget without a lengthy Rust rebuild. Rebuild
# it with Tools/build-xcframework.sh after each Reckless engine update and
# commit the result. (No NNUE net is baked in; it loads at runtime from
# rust/networks/.)

# SwiftPM scratch/build dirs (incl. isolated --scratch-path)
.build*/
Frameworks/*.xcframework
RecklessFFI.xcframework.zip
