# Swift / SPM
.build/
Package.resolved
*.o
*.d
DerivedData/

# Xcode
*.xcodeproj/
xcuserdata/

# Rust
rust/target/
Cargo.lock

# Python bytecode from .github/scripts helpers — never commit build artifacts.
__pycache__/
*.pyc

# NEVER COMMIT ENGINE WEIGHTS / NNUE NETS
# (same policy as Fianchetto / SwiftStockfish)
*.nnue
*.onnx
*.bin
networks/

# macOS
.DS_Store

# Temporary download parts
*.part

# Built xcframework — large (~90 MB), built on-demand via Tools/build-xcframework.sh.
# (No NNUE net is baked in; the net is loaded at runtime from rust/networks/.)
# The xcframework is NOT committed; run the script after each Reckless update.
Frameworks/RecklessFFI.xcframework/
Frameworks/*.xcframework
RecklessFFI.xcframework.zip
