# Swift / SPM
.build/
Package.resolved
*.o
*.d
DerivedData/

# Xcode
*.xcodeproj/
xcuserdata/

# Rust
rust/target/
# `rust/Cargo.lock` is committed because this repository builds and ships
# native binary artifacts from the Rust crate.

# Python bytecode from .github/scripts helpers — never commit build artifacts.
__pycache__/
*.pyc

# NEVER COMMIT ENGINE WEIGHTS / NNUE NETS
# (same policy as Fianchetto / SwiftStockfish)
*.nnue
*.onnx
*.bin
networks/

# macOS
.DS_Store

# Temporary download parts
*.part

# The RecklessFFI.xcframework is a RELEASE ARTIFACT, never committed. It was
# committed until 2026-09-07 for one reason: SwiftPM cannot fetch a
# binaryTarget's release asset from a PRIVATE repository, so url: mode worked
# for nobody and the committed binary was the only delivery that functioned.
# Publishing this package made url: mode real, and 610.5 MB of accumulated
# framework blobs — 101 of them, one per rebuild — came out of history.
#
# Build it locally with Tools/build-xcframework.sh; release tags carry a
# url:+checksum: binaryTarget pointing at the published asset. Consumers never
# need the script. (No NNUE net is baked in; it loads at runtime from
# rust/networks/.)
Frameworks/RecklessFFI.xcframework/

# THE WINDOWS BUNDLE IS NOT COMMITTED EITHER — and it never was, which is why
# the paragraph below already made this argument correctly while the
# xcframework above spent a year as the exception to it. It is a release
# artifact: built by
# Tools/build-windows-artifactbundle.sh, attached to the tagged release, and
# reached by consumers through the url:+checksum: binaryTarget the release
# rewrite installs. Two 13 MB archives per engine bump is not a thing to add to
# git history when a release asset carries them just as well.
#
# Package.swift takes the Windows binary arm only when this bundle is PRESENT,
# so a clone without it behaves exactly as this package did before the bundle
# existed — the source arm, stubs unless SWIFTRECKLESS_LINK_ARCHIVE=1. Absence
# is a supported state, not a broken one.
Frameworks/RecklessWindowsFFI.artifactbundle/

# SwiftPM scratch/build dirs (incl. isolated --scratch-path)
.build*/

# Xcode's build output, which is NOT the same directory as SwiftPM's `.build`
# and was matched by neither `.build/` nor `.build*/` above — both require the
# leading dot. A `git add -A` therefore staged 111 MB of it, including a 36 MB
# libcreckless-macos.a and a shelf of .pcm modules. Same gap, same fix, for
# Tools/build-android.sh's output directory: 85 MB of prebuilt static libs
# across four ABIs, regenerated by that script and belonging in a release
# asset if they are ever to be shipped at all.
build/
android-libs/
